{
 "load_balancers": [
  {
   "name": "legacy-public",
   "is_private": false,
   "listeners": [
    {
     "name": "web80",
     "port": 80,
     "protocol": "HTTP",
     "default_backend_set": "app",
     "hostnames": [
      "www.example.com",
      "missing.example.com"
     ],
     "routing_policy": "p"
    },
    {
     "name": "web443",
     "port": 443,
     "protocol": "HTTPS",
     "default_backend_set": "app",
     "ssl": {
      "certificate_name": "old-cert",
      "protocols": [
       "TLSv1",
       "TLSv1.2"
      ]
     }
    },
    {
     "name": "nocert",
     "port": 8443,
     "protocol": "HTTPS",
     "default_backend_set": "missing"
    },
    {
     "name": "ssh",
     "port": 22,
     "protocol": "TCP",
     "default_backend_set": "jump"
    },
    {
     "name": "ghostcert",
     "port": 9443,
     "protocol": "HTTPS",
     "default_backend_set": "app",
     "ssl": {
      "certificate_name": "ghost-cert",
      "protocols": [
       "TLSv1.2"
      ]
     }
    }
   ],
   "backend_sets": [
    {
     "name": "app",
     "policy": "ROUND_ROBIN",
     "health_checker": {
      "protocol": "HTTP",
      "interval_ms": 3000,
      "timeout_ms": 3000,
      "retries": 1
     },
     "backends": [
      {
       "ip": "10.0.1.11",
       "port": 8080
      }
     ]
    },
    {
     "name": "jump",
     "backends": [
      {
       "ip": "10.0.9.9",
       "port": 22,
       "offline": true
      }
     ]
    },
    {
     "name": "orphan",
     "health_checker": {
      "protocol": "TCP"
     },
     "backends": [
      {
       "ip": "10.0.3.1",
       "port": 80
      },
      {
       "ip": "10.0.3.1",
       "port": 80
      }
     ]
    }
   ],
   "certificates": [
    {
     "name": "old-cert",
     "not_after": "2026-09-20"
    },
    {
     "name": "soon",
     "not_after": "2026-10-15"
    }
   ],
   "hostnames": [
    "www.example.com",
    "unused.example.com"
   ],
   "routing_policies": [
    {
     "name": "p",
     "rules": [
      {
       "name": "all-api",
       "condition": {
        "path_prefix": "/api"
       },
       "backend_set": "app"
      },
      {
       "name": "api-v1",
       "condition": {
        "path_prefix": "/api/v1"
       },
       "backend_set": "app"
      },
      {
       "name": "ghost-target",
       "condition": {
        "hostname": "www.example.com",
        "path_exact": "/x"
       },
       "backend_set": "nowhere"
      }
     ]
    },
    {
     "name": "idle",
     "rules": []
    }
   ]
  },
  {
   "name": "swapped-ports",
   "is_private": true,
   "listeners": [
    {
     "name": "odd",
     "port": 443,
     "protocol": "HTTP",
     "default_backend_set": "b"
    }
   ],
   "backend_sets": [
    {
     "name": "b",
     "health_checker": {
      "protocol": "TCP",
      "interval_ms": 10000,
      "timeout_ms": 3000,
      "retries": 3
     },
     "backends": [
      {
       "ip": "10.2.0.1",
       "port": 80
      },
      {
       "ip": "10.2.0.2",
       "port": 80
      }
     ]
    }
   ]
  }
 ]
}